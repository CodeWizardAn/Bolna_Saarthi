# =============================================================================
# Haki FMCG 2.0 - Environment Configuration
# =============================================================================

# --- LLM API Keys (Optional - Enables Generative AI Reasoning) ---
# Get free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=
# Or OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Application Secrets ---
JWT_SECRET_KEY=haki_fmcg_production_jwt_secret_key_2026_rfp_secure

# --- Database & Caching (Optional - Falls back to local SQLite & LRU Cache) ---
# Set USE_IBM_DB2=true to activate IBM Db2 Enterprise Engine
USE_IBM_DB2=false
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=BLUDB
DB2_USER=db2inst1
DB2_PASSWORD=
DB2_SECURITY=
DB2_SCHEMA=SAARTHI

MONGO_URI=mongodb://localhost:27017
MONGO_DB=haki_fmcg
REDIS_HOST=localhost
REDIS_PORT=6379

# --- OCR Engine (Optional - Scanned Image PDFs) ---
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
